      "end": 34.355000000000004,
      "duration": 12.585
    },
    {
      "id": "arrival",
      "text": "第三天，宫门真的开了。史书写下六个字：味未变，已至京师。",
      "purpose": "短暂胜利",
      "index": 3,
      "file": "public/audio/lychee-road/04-arrival.wav",
      "provider": "kokoro-local",
      "start": 34.355000000000004,
      "end": 41.220000000000006,
      "duration": 6.865
    },
    {
      "id": "cost",
      "text": "可另一份记载说，人马死于路者甚众，百姓苦之。",
      "purpose": "史实反转",
