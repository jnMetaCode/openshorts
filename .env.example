HOST=127.0.0.1
PORT=4174
# 允许发起写请求的浏览器来源，逗号分隔。留空则只放行本机与 Vite 开发端口。
# 从局域网地址访问 Studio 时需要显式填写，例如 http://192.168.1.5:4174
OPENSHORTS_ALLOWED_ORIGINS=
OPENSHORTS_RENDER_CONCURRENCY=1
CHROME_PATH=
COMFYUI_URL=
OPENSHORTS_PLANNER_URL=
OPENSHORTS_PLANNER_MODEL=
OPENSHORTS_PLANNER_API_KEY=
OPENSHORTS_ASR_COMMAND=
OPENSHORTS_ASR_ARGS_JSON=[]

# ── v2 开片（这些都可不填）──
# 命令行语言：zh | en；不填按系统 locale（locale 没设时中文）。它不决定片子的语言（那是 new --lang）
OPENSHORTS_LANG=
# 用别的 ffmpeg（须带 libass 才能烧字幕）；不填优先用 ~/.openshorts/bin 里自己装的，再退到 PATH
OPENSHORTS_FFMPEG=
# install-ffmpeg 的逃生口：装非钉死版本（不校验 sha256）。正常不用
OPENSHORTS_FFMPEG_TAG=
# 配置与缓存根目录（默认 ~/.openshorts）
OPENSHORTS_HOME=
# 指向本地 agency-orchestrator 检出，改工作流 / 技能时不用先发 npm 再验；不填用 node_modules 里那份
OPENSHORTS_AO_DIR=
# v1 图层编辑器的写目录（桌面版打包后资源只读时用）
OPENSHORTS_V1_DATA=
