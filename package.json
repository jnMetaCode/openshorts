{
  "name": "openshorts",
  "version": "2.0.0-alpha.21",
  "private": true,
  "type": "module",
  "description": "Local-first layered paper collage video editor powered by Remotion",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "!dist/audio",
    "!dist/uploads",
    "server",
    "shared",
    "scripts",
    "src",
    "!src/studio/**/*.css.map",
    "public/assets",
    "!public/assets/generated",
    "!public/audio",
    "templates",
    "adapters",
    "docs/v2",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "open": "node scripts/open-local.mjs",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "node scripts/render.mjs",
    "quality": "node scripts/quality-report.mjs",
    "assets": "node scripts/process-assets.mjs",
    "bundle": "node scripts/package-project.mjs",
    "draft": "node scripts/create-storyboard.mjs",
    "review": "node scripts/review-project.mjs",
    "captions": "node scripts/apply-transcript.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:bundle": "node scripts/create-release-bundle.mjs",
    "validate": "node scripts/validate-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "master": "node scripts/master-audio.mjs",
    "story": "node scripts/story.mjs",
    "music": "node scripts/import-music.mjs",
    "voices": "node scripts/preview-voices.mjs",
    "asset": "node scripts/record-asset.mjs",
    "comfy": "node scripts/comfy-asset.mjs",
    "new": "node scripts/draft-story.mjs",
    "openshorts": "node bin/openshorts.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "agency-orchestrator": "^0.19.1",
    "cors": "2.8.5",
    "express": "5.1.0",
    "msedge-tts": "^2.0.7",
    "multer": "2.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.499",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  },
  "bin": {
    "openshorts": "bin/openshorts.mjs"
  }
}
